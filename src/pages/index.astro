---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <section class="contact-card">
        <div class="contact-info">
          <p><strong>Brian M. Knight</strong></p>
          <p>Broker Pal, LLC</p>
          <p>Commercial Mortgage Consultant</p>
          <p>Specializing in DSCR, Fix n Flip, Bridge and Business Purpose loans</p>
          <p>
            <a href="mailto:brian@yourbrokerpal.com">brian@yourbrokerpal.com</a>
          </p>
        </div>
      </section>
    </main>
    <Footer />

    <style>
      body {
        margin: 0;
        background: #f6f7f8;
        color: #1f2937;
      }

      main {
        padding: 2rem 1rem 4rem;
      }

      .contact-card {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 0.5rem;
      }

      .contact-info {
        background: #ffffff;
        border: 1px solid #dbe2ea;
        border-radius: 16px;
        padding: 2rem;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
      }

      .contact-info p {
        margin: 0.5rem 0;
        font-size: 1.05rem;
      }

      .contact-info a {
        color: #0d3b66;
        font-weight: 700;
      }
    </style>
  </body>
</html>
