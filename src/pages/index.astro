---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <section style="max-width: 900px; margin: 0 auto; padding: 4rem 1.5rem 2rem;">
        <h1 style="font-size: clamp(2.2rem, 5vw, 4.5rem); margin-bottom: 1rem;">Broker Pal</h1>
        <p style="font-size: 1.2rem; margin-bottom: 1.5rem; color: #2d3748;">
          Commercial Mortgage Consultant
        </p>

        <p style="font-size: 1.1rem; line-height: 1.8; color: #1a202c;">
          Specializing in DSCR, Fix n Flip, Bridge and Business Purpose loans.
        </p>

        <div style="margin-top: 2rem; padding: 1.5rem; border: 1px solid #d9e2ec; border-radius: 12px; background: #f8fafc;">
          <p><strong>Brian M. Knight</strong></p>
          <p>Broker Pal, LLC</p>
          <p>Commercial Mortgage Consultant</p>
          <p>Specializing in DSCR, Fix n Flip, Bridge and Business Purpose loans</p>
          <p>
            <a href="mailto:brian@yourbrokerpal.com">brian@yourbrokerpal.com</a>
          </p>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
