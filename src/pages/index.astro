---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <section class="hero">
        <div class="hero-copy">
          <img src="/logo.svg" alt="Broker Pal logo" class="brand-logo" />
          <p class="tagline">Commercial Mortgage Consultant</p>
          <p class="summary">
            Specializing in DSCR, Fix n Flip, Bridge and Business Purpose loans.
          </p>
        </div>

        <div class="hero-portrait">
          <img src="/headshot.svg" alt="Brian M. Knight" />
        </div>
      </section>

      <section class="contact-card">
        <div class="contact-info">
          <p><strong>Brian M. Knight</strong></p>
          <p>Broker Pal, LLC</p>
          <p>Commercial Mortgage Consultant</p>
          <p>Specializing in DSCR, Fix n Flip, Bridge and Business Purpose loans</p>
          <p>
            <a href="mailto:brian@yourbrokerpal.com">brian@yourbrokerpal.com</a>
          </p>
        </div>
      </section>
    </main>
    <Footer />

    <style>
      body {
        margin: 0;
        background: #f6f7f8;
        color: #1f2937;
      }

      main {
        padding: 2rem 1rem 4rem;
      }

      .hero {
        max-width: 1200px;
        margin: 0 auto 2rem;
        display: grid;
        grid-template-columns: 1.4fr 0.8fr;
        align-items: center;
        gap: 2rem;
      }

      .hero-copy {
        padding-left: 0.5rem;
      }

      .brand-logo {
        width: min(100%, 720px);
        height: auto;
        display: block;
        margin-bottom: 1rem;
      }

      .tagline {
        font-size: clamp(1.2rem, 2vw, 2rem);
        margin: 0 0 0.75rem;
        color: #1d4e89;
        font-weight: 600;
      }

      .summary {
        font-size: clamp(1rem, 1.7vw, 1.35rem);
        line-height: 1.7;
        max-width: 620px;
      }

      .hero-portrait {
        display: flex;
        justify-content: center;
      }

      .hero-portrait img {
        width: min(100%, 420px);
        height: auto;
        border-radius: 24px;
        box-shadow: 0 18px 35px rgba(15, 23, 42, 0.12);
        background: #e5e7eb;
      }

      .contact-card {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 0.5rem;
      }

      .contact-info {
        background: #ffffff;
        border: 1px solid #dbe2ea;
        border-radius: 16px;
        padding: 2rem;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
      }

      .contact-info p {
        margin: 0.5rem 0;
        font-size: 1.05rem;
      }

      .contact-info a {
        color: #0d3b66;
        font-weight: 700;
      }

      @media (max-width: 800px) {
        .hero {
          grid-template-columns: 1fr;
          text-align: center;
        }

        .hero-copy {
          padding-left: 0;
        }

        .brand-logo {
          margin: 0 auto 1rem;
        }
      }
    </style>
  </body>
</html>
